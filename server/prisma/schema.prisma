generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  username     String
  email        String @unique
  passwordHash String

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  verificationToken  String?
  verificationExpiry DateTime?
  roleId             String    @db.ObjectId
  languageId         String    @db.ObjectId

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Role      @relation(fields: [roleId], references: [id])
  language  Language  @relation(fields: [languageId], references: [id])
  deletedAt DateTime?

  images Image[]
    customization Customization[]

}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  canBook            Boolean @default(false)
  canCustomize       Boolean @default(false)
  canManageUsers     Boolean @default(false)
  canAccessAnalytics Boolean @default(false)

  users User[]
}

model Language {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String  @unique
  name      String
  isDefault Boolean @default(false)

  users User[]
}

model Theme {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  theme_name  String
  theme_slug  String  @unique
  description String?

  cover_image_id String? @db.ObjectId
  cover_image    Image?  @relation("ThemeCover", fields: [cover_image_id], references: [id])

  images ThemeImage[]
  activity Activity[]
  destination Destination[]
  tour_packages TourPackage[]
  
  display_order Int     @default(0)
  is_active     Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Image {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  file_name String
  file_url  String
  file_type FileType

  uploaded_by String @db.ObjectId
  uploadedBy  User   @relation(fields: [uploaded_by], references: [id])

  alt_text_en String?
  alt_text_sw String?

    entity_type   String?
  entity_id     String?  @db.ObjectId

  coverThemes Theme[]      @relation("ThemeCover")
  themes      ThemeImage[]
  coverDestinations Destination[] @relation("DestinationCover")
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ThemeImage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  themeId String @db.ObjectId
  imageId String @db.ObjectId

  theme Theme @relation(fields: [themeId], references: [id])
  image Image @relation(fields: [imageId], references: [id])

  created_at DateTime @default(now())
}

enum FileType {
  IMAGE
  VIDEO
}

model Destination {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  destination_name String
  description      String?
  region           String

  theme_id String @db.ObjectId
  theme    Theme  @relation(fields: [theme_id], references: [id])

  cover_image_id String? @db.ObjectId
  cover_image    Image?  @relation("DestinationCover", fields: [cover_image_id], references: [id])

  is_active Boolean @default(true)

  activity Activity[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


model Activity {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  activity_name String
  description   String

  theme_id String @db.ObjectId
  theme    Theme  @relation(fields: [theme_id], references: [id])

  destination_id String @db.ObjectId
  destination     Destination @relation(fields: [destination_id], references: [id])

  difficulty_level String
  duration_hours   Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}


model TourPackage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  package_name String
  package_slug String @unique

  short_description String
  full_description  String

  theme_id String @db.ObjectId
  theme Theme @relation(fields: [theme_id], references: [id])

  duration_days Int
  base_price Float

  is_featured Boolean @default(false)

  status PackageStatus @default(ACTIVE)
  customization Customization[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  DRAFT
}


model Customization {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  package_id String
  tourPackage TourPackage @relation(fields: [package_id], references: [id])

  selected_destinations Json?
  selected_activities   Json?

  group_size     Int
  duration_days  Int

  accommodation_level AccommodationLevel
  budget_range        String

  status CustomizationStatus @default(PENDING)

  shareable_url String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum AccommodationLevel {
  LOW
  MEDIUM
  HIGH
  LUXURY
}

enum CustomizationStatus {
  PENDING
  CONFIRMED
  DRAFT
}