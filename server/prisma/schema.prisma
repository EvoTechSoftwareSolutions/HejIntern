model Contact {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name   String
  email  String
  phone  String
  subject String

  enquiry_type ContactType

  language   Language? @relation(fields: [language_id], references: [id])
language_id String?

  status ContactStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum ContactType {
  GENERAL
  BOOKING
  PAYMENT
  SUPPORT
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Stay {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  name_sv    String?
  location   String
  location_sv String?
  rating     Float    @default(4.5)
  image      String   @default("stay")
  featured   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}